# Copy to .env . Real environment variables win over anything set here.
# No credentials needed -- both sources read local files only.

# --- Paths (optional) ------------------------------------------------------
# Relative paths are resolved against the repository directory, not your shell's
# current directory, so these mean the same thing wherever you run the collector
# from. Use an absolute path to put data somewhere else entirely.
# AIU_DB=./data/usage.db
# AIU_ARCHIVE=./data/archive
# AIU_ARCHIVE_CODEX=./data/archive-codex   # defaults beside AIU_ARCHIVE
# AIU_CLAUDE_DIR=~/.claude
# AIU_CODEX_DIR=~/.codex
# Xcode's built-in Claude and Codex assistants keep their sessions elsewhere.
# AIU_XCODE_DIR=~/Library/Developer/Xcode/CodingAssistant
# AIU_XCODE_CLAUDE_DIR=   # defaults to $AIU_XCODE_DIR/ClaudeAgentConfig
# AIU_XCODE_CODEX_DIR=    # defaults to $AIU_XCODE_DIR/codex
# AIU_ARCHIVE_XCODE_CLAUDE=./data/archive-xcode-claude
# AIU_ARCHIVE_XCODE_CODEX=./data/archive-xcode-codex
# AIU_DASHBOARD=./dashboard.html

# --- Session bar (optional) ------------------------------------------------
# The dashboard's "Current session" bar fills against the costliest 5-hour
# window in your own history. The real plan limit is server-side and cannot be
# read locally, so set this (estimated list-price dollars per 5-hour window) to
# calibrate it, e.g. against what /usage shows at a known moment.
# AIU_SESSION_BUDGET_USD=
