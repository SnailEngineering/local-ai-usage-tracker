# Copy to .env . Real environment variables win over anything set here.

# --- Anthropic -------------------------------------------------------------
# Admin API key (sk-ant-admin01-...). Organizations only -- individual accounts
# cannot create one. Leave blank to rely on the local Claude Code ingest, which
# needs no credentials and lands in the same table.
# Create at: Console -> Settings -> Admin keys
ANTHROPIC_ADMIN_KEY=

# --- OpenAI ----------------------------------------------------------------
# Admin key (sk-admin-...), NOT a project key (sk-proj-...).
# Create at: platform.openai.com -> Settings -> Organization -> Admin keys
OPENAI_ADMIN_KEY=

# Note: neither key is needed for the local Claude Code / Codex ingest, which
# is the only path to $20-plan subscription usage.

# --- Paths (optional) ------------------------------------------------------
# AIU_DB=./data/usage.db
# AIU_ARCHIVE=./data/archive
# AIU_CLAUDE_DIR=~/.claude
# AIU_CODEX_DIR=~/.codex
# AIU_DASHBOARD=./dashboard.html

# How far back to reach on the first API run. Ignored afterwards -- later runs
# re-read a rolling 7-day window, which is enough to catch restated buckets.
# AIU_BACKFILL_DAYS=365
