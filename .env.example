# Copy to .env . Real environment variables win over anything set here.
# No credentials needed -- both sources read local files only.

# --- Paths (optional) ------------------------------------------------------
# Relative paths are resolved against the repository directory, not your shell's
# current directory, so these mean the same thing wherever you run the collector
# from. Use an absolute path to put data somewhere else entirely.
# AIU_DB=./data/usage.db
# AIU_ARCHIVE=./data/archive
# AIU_CLAUDE_DIR=~/.claude
# AIU_CODEX_DIR=~/.codex
# AIU_DASHBOARD=./dashboard.html
