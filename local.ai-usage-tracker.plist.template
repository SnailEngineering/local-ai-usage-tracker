<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ai-usage-tracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO_DIR__/collect.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>

  <!-- 09:00 and 21:00 daily. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- launchd already runs a missed StartCalendarInterval when the Mac wakes,
       so the schedule survives a closed lid on its own. RunAtLoad is here for
       a different reason: it collects once at login, so a machine that is only
       awake outside 09:00/21:00 still gets a run. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO_DIR__/data/collect.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_DIR__/data/collect.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
